{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/src"],
  "testEnvironment": "node",
  "testRegex": ".*\\.pg-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "globalSetup": "<rootDir>/test/pg/global-setup.mjs",
  "globalTeardown": "<rootDir>/test/pg/global-teardown.mjs",
  "testTimeout": 120000,
  "maxWorkers": 1
}
